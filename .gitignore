# flair lib ships as a prebuilt wheel under wheels/ — MUST be committed (do not ignore)
!wheels/
!wheels/*.whl

# site-prefixed run outputs (PHI stays local; non-PHI is uploaded out-of-band)
*_flair_phi/
*_flair_non_phi_for_upload/
*_flair_v*/
*_baseline_models/

# legacy / scratch output roots + clifpy caches and logs
out/
out_external/
output/
logs/

# per-task resume stamps written by run_mimic_train.sh
.mimic_run_stamps/
*.log

# real site configs — scaffold one with `flair init-config --out config`
clif_config*.json

# python / uv
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.parquet